# Local dev: copy to .env. On Render, set these under Environment. Never commit .env.
SESSION_SECRET=            # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=      # Project Settings > API > service_role (secret!)
DATABASE_URL=              # optional but recommended: Supabase "Session pooler" connection string, for persistent sessions

# Only for `node seed.js`
SEED_PRESIDENT_NAME=Your Name
SEED_PRESIDENT_EMAIL=you@example.com
SEED_PRESIDENT_PASSWORD=
